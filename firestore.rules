rules_version = '2';

// sortafun leaderboards — anyone can read scores, anyone can add one score at a
// time (if it passes the shape checks below), nobody can delete, and the only
// edit is a live row (word hive, daily sudoku) climbing, and its owner
// renaming it, until midnight (isLiveUpdate).
//
// Note: scores are submitted straight from the player's browser, so a determined
// person can still forge a number. These rules stop junk data and drive-by
// vandalism, not cheating. That's a deliberate trade for "no server".

service cloud.firestore {
  match /databases/{database}/documents {

    match /scores/{id} {
      allow read: if true;
      allow delete: if false;
      allow create: if isValidScore(request.resource.data);
      // a live row (live: true; word hive, daily sudoku): it climbs until Singapore midnight
      allow update: if isLiveUpdate(id, resource.data, request.resource.data);
    }

    // --- the secret behind each live row: hive_keys/<row id> = { k, n } ---
    // (named for word hive, where it started; the id is the scores row id, so
    // it serves every live game: hive and sudoku)
    // Nobody can read these (rules' get() still can). Renaming a live row
    // needs the same batch to bump n here, and bumping n needs k, which only
    // the player's devices know (this device, and the codephrase save). Made
    // in the same batch as its row, never for a row that already exists.
    match /hive_keys/{id} {
      allow read, delete: if false;
      allow create: if id.matches('[A-Za-z0-9]{20}')
        && request.resource.data.keys().hasOnly(['k', 'n'])
        && request.resource.data.k is string && request.resource.data.k.matches('[A-Za-z0-9]{24}')
        && request.resource.data.n == 0
        && !exists(/databases/$(database)/documents/scores/$(id))
        && existsAfter(/databases/$(database)/documents/scores/$(id))
        && getAfter(/databases/$(database)/documents/scores/$(id)).data.get('live', false) == true;
      allow update: if request.resource.data.keys().hasOnly(['k', 'n'])
        && request.resource.data.k == resource.data.k
        && request.resource.data.n == resource.data.n + 1;
    }
    function ownsRow(id) {
      let key = /databases/$(database)/documents/hive_keys/$(id);
      return exists(key) && getAfter(key).data.n == get(key).data.n + 1;
    }

    // is this "YYYY-MM-DD" today in Singapore time (UTC+8, no DST)?
    function isSgToday(day) {
      let p = day.split('-');
      let start = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      let now = request.time + duration.value(8, 'h');
      return now >= start && now < start + duration.value(1, 'd');
    }

    // a live hive row only ever goes up, on the same day, until midnight. Its
    // name can change until then too, but only by its owner (ownsRow).
    // (anyone who knows the row id could raise it, never lower or rename it:
    // the same "stops junk, not a determined forger" trade as above)
    function isLiveUpdate(id, o, n) {
      return isLiveGame(o.game) && o.get('live', false) == true
        && n.diff(o).affectedKeys().hasOnly(['score', 'rankValue', 'ts', 'bee', 'name'])
        && (!n.diff(o).affectedKeys().hasAny(['name']) || ownsRow(id))
        && isValidScore(n)
        && n.score >= o.score
        && isSgToday(o.day);
    }

    // games with a live daily row (one per player per day, climbing until midnight)
    function isLiveGame(g) {
      return g in ['hive', 'sudoku'];
    }

    // games whose leaderboard ranks lowest-score-best: they store rankValue == -score
    function isLowGame(g) {
      return g in ['puzzle', 'circuit', 'reaction', 'maze', 'ladder', 'mines', 'minute', 'five', 'sides'];
    }

    function isValidScore(d) {
      return d.keys().hasOnly(['game', 'name', 'score', 'rankValue', 'day', 'ts', 'bee', 'arch', 'live'])
        && (!('bee' in d) || (d.bee == true && d.game == 'hive'))
        && (!('arch' in d) || (d.arch == true && d.game == 'hive'))
        && (!('live' in d) || (d.live == true && isLiveGame(d.game) && !('arch' in d) && isSgToday(d.day)))
        && d.game in ['typing', 'typing1000', 'driving', 'puzzle', 'circuit',
                      'reaction', 'maze', 'aim', 'stopbar', 'ladder', 'anagram',
                      'mines', 'fermi', 'minute', 'callit', 'watch', 'hive',
                      'five', 'sides', 'grab', 'birdie', 'city', 'deeptime',
                      'taka', 'deeptime2', 'sushi', 'sushirush', 'funstrike',
                      'sudoku']
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && d.score is int && d.score >= 0 && d.score <= 1000000
        && d.rankValue is int
        && (
             (isLowGame(d.game) && d.rankValue == 0 - d.score) ||
             (!isLowGame(d.game) && d.rankValue == d.score)
           )
        && d.day is string && d.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.ts == request.time;
    }

    // --- guestbook (guestbook.html) : append-only, world readable ---
    match /guestbook/{id} {
      allow read: if true;
      allow update, delete: if false;
      allow create: if isValidSig(request.resource.data);
    }
    function isValidSig(d) {
      return d.keys().hasOnly(['name', 'msg', 'ts'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 30
        && d.msg is string && d.msg.size() >= 1 && d.msg.size() <= 400
        && d.ts == request.time;
    }

    // --- feedback (feedback.js, the bubble on every page) : create only ---
    // Not readable from the site: Caleb reads it in the Firebase console.
    // game is a free-form slug (not an enum) so a new game never needs a
    // rules change here. rating is 0..5, or null for "didn't rate" (a
    // deliberate 0 is a real answer). Needs a rating or some words.
    match /feedback/{id} {
      allow read: if isAdmin();   // admin.html signs in as the site owner; nobody else can read it
      allow update, delete: if false;
      allow create: if isValidFeedback(request.resource.data);
    }

    // --- admin.html (the dashboard): only the owner's email/password account may touch these ---
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@sortafun.org'
        && request.auth.token.email_verified == true;
    }
    match /admin_todos/{id} { allow read, write: if isAdmin(); }
    match /admin_state/{id} { allow read, write: if isAdmin(); }
    function isValidFeedback(d) {
      return d.keys().hasOnly(['game', 'rating', 'kind', 'msg', 'name', 'page', 'day', 'ts', 'ver'])
        && d.keys().hasAll(['game', 'rating', 'kind', 'msg', 'day', 'ts'])
        && d.game is string && d.game.matches('[a-z0-9-]{1,30}')
        && (d.rating == null || (d.rating is int && d.rating >= 0 && d.rating <= 5))
        && d.kind in ['bug', 'change', 'general']
        && d.msg is string && d.msg.size() <= 1000
        && (d.rating != null || d.msg.size() >= 1)
        && (!('name' in d) || (d.name is string && d.name.size() <= 20))
        && (!('page' in d) || (d.page is string && d.page.size() <= 80))
        && (!('ver' in d) || (d.ver is string && d.ver.size() <= 12))
        && d.day is string && d.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.ts == request.time;
    }

    // --- word hive saved progress (anagram.html): a codephrase like fluffy-antelope is the doc id.
    // Readable one doc at a time by anyone who knows the phrase (no listing), writable the same way. Low stakes.
    match /hive_saves/{code} {
      allow get: if code.matches('[a-z]{3,12}-[a-z]{3,12}');
      allow list, delete: if false;
      allow create: if isValidSave(code, request.resource.data);
      allow update: if isValidSave(code, request.resource.data) && request.resource.data.day == resource.data.day;
    }
    function isValidSave(code, d) {
      return code.matches('[a-z]{3,12}-[a-z]{3,12}')
        && d.keys().hasOnly(['day', 'words', 'ts', 'lb', 'name', 'k'])
        && d.day is string && d.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.words is list && d.words.size() <= 500
        && (!('lb' in d) || (d.lb is string && d.lb.matches('[A-Za-z0-9]{20}')))
        && (!('name' in d) || (d.name is string && d.name.size() >= 1 && d.name.size() <= 20))
        && (!('k' in d) || (d.k is string && d.k.matches('[A-Za-z0-9]{24}')))
        && d.ts == request.time;
    }

    // --- daily sudoku progress (sudoku.html) under a codephrase, like hive_saves ---
    // { day, ts, st: { easy?, hard?, extreme? }, lb?, name?, k? }. Each puzzle is
    // { v: 81 digits, t: ms, e: errors, done, score? }. A finished puzzle stays finished.
    match /sudoku_saves/{code} {
      allow get: if code.matches('[a-z]{3,12}-[a-z]{3,12}');
      allow list, delete: if false;
      allow create: if isValidSudokuSave(code, request.resource.data);
      allow update: if isValidSudokuSave(code, request.resource.data)
        && request.resource.data.day == resource.data.day
        && stillDone(resource.data.st, request.resource.data.st, 'easy')
        && stillDone(resource.data.st, request.resource.data.st, 'hard')
        && stillDone(resource.data.st, request.resource.data.st, 'extreme');
    }
    function stillDone(o, n, k) {
      return !(k in o) || o[k].done != true || (k in n && n[k].done == true);
    }
    function isValidSudokuPuzzle(st, k) {
      return !(k in st) || (
        st[k] is map && st[k].keys().hasOnly(['v', 't', 'e', 'done', 'score'])
        && st[k].v is string && st[k].v.matches('[0-9]{81}')
        && st[k].t is int && st[k].t >= 0
        && st[k].e is int && st[k].e >= 0
        && st[k].done is bool
        && (!('score' in st[k]) || (st[k].score is int && st[k].score >= 0 && st[k].score <= 100000)));
    }
    function isValidSudokuSave(code, d) {
      return code.matches('[a-z]{3,12}-[a-z]{3,12}')
        && d.keys().hasOnly(['day', 'ts', 'st', 'lb', 'name', 'k'])
        && d.day is string && d.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.st is map && d.st.keys().hasOnly(['easy', 'hard', 'extreme'])
        && isValidSudokuPuzzle(d.st, 'easy') && isValidSudokuPuzzle(d.st, 'hard') && isValidSudokuPuzzle(d.st, 'extreme')
        && (!('lb' in d) || (d.lb is string && d.lb.matches('[A-Za-z0-9]{20}')))
        && (!('name' in d) || (d.name is string && d.name.size() >= 1 && d.name.size() <= 20))
        && (!('k' in d) || (d.k is string && d.k.matches('[A-Za-z0-9]{24}')))
        && d.ts == request.time;
    }

    // --- hit counter : one doc stats/hits, count only ever goes up by 1 ---
    match /stats/{id} {
      allow read: if true;
      allow delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count == resource.data.count + 1;
    }

    // --- animation gallery (flipbook.html posts here, anim-gallery.html reads) ---
    //
    // Anyone reads. Anyone posts one animation that passes the shape check.
    // The only allowed update is a vote: +1 to `votes`, nothing else touched.
    // No edits, no deletes. Comments are append-only. Same "stops junk, not a
    // determined forger" trade as the scores above.

    match /animations/{id} {
      allow read: if true;
      allow delete: if false;
      allow create: if isValidAnim(request.resource.data);
      allow update: if isVoteOnly(resource.data, request.resource.data);
    }

    match /anim_comments/{id} {
      allow read: if true;
      allow update, delete: if false;
      allow create: if isValidComment(request.resource.data);
    }

    function isValidAnim(d) {
      return d.keys().hasOnly(['title', 'author', 'fps', 'w', 'h', 'frames', 'votes', 'createdAt', 'day'])
        && d.title is string && d.title.size() <= 60
        && d.author is string && d.author.size() >= 1 && d.author.size() <= 20
        && d.fps is int && d.fps >= 1 && d.fps <= 24
        && d.w is int && d.w > 0 && d.w <= 2000
        && d.h is int && d.h > 0 && d.h <= 2000
        && d.frames is list && d.frames.size() >= 1 && d.frames.size() <= 1000
        && d.votes == 0
        && d.createdAt == request.time
        && d.day is string && d.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    function isVoteOnly(old, nw) {
      return nw.diff(old).affectedKeys().hasOnly(['votes'])
        && nw.votes is int
        && nw.votes == old.votes + 1;
    }

    function isValidComment(d) {
      return d.keys().hasOnly(['animId', 'author', 'body', 'createdAt'])
        && d.animId is string && d.animId.size() >= 1 && d.animId.size() <= 40
        && d.author is string && d.author.size() >= 1 && d.author.size() <= 20
        && d.body is string && d.body.size() >= 1 && d.body.size() <= 600
        && d.createdAt == request.time;
    }
  }
}
