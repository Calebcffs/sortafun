{
  "rules": {
    "chat": {
      "msgs": {
        ".read": true,
        ".indexOn": ["t"],
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.exists()) || (!newData.exists() && data.child('t').val() < now - 60000))",
          ".validate": "newData.hasChildren(['u', 'n', 'm', 't']) && newData.child('u').val() === auth.uid && newData.child('t').val() === now && newData.parent().parent().child('last/' + auth.uid).val() === now",
          "u": { ".validate": true },
          "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
          "m": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
          "t": { ".validate": true },
          "$other": { ".validate": false }
        }
      },
      "last": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber() && newData.val() === now && (!data.exists() || data.val() < now - 1500)"
        }
      },
      "online": {
        ".read": true,
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber() && newData.val() <= now"
        }
      }
    },
    "city": {
      "players": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['n', 'k', 's', 'st', 't'])",
          "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
          "k": { ".validate": "newData.isString() && newData.val().matches(/^[hb]$/)" },
          "s": { ".validate": "newData.isString() && newData.val().matches(/^[a-z-]{2,12}$/)" },
          "st": { ".validate": "newData.isString() && newData.val().length <= 140" },
          "w": { ".validate": "newData.isString() && newData.val().matches(/^[a-z]{0,12}$/)" },
          "v": { ".validate": "newData.isString() && newData.val().matches(/^[a-z-]{0,20}$/)" },
          "vi": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "fx": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "hp": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "pc": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "cc": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "sc": { ".validate": "newData.isNumber()" },
          "t": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "z": { ".validate": "newData.isString() && newData.val().length <= 1400" },
          "se": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8" },
          "tn": { ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1)" },
          "lv": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999" },
          "cr": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "cn": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "pg": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "qc": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "$other": { ".validate": false }
        }
      },
      "zhits": {
        "$owner": {
          ".read": "auth != null && auth.uid === $owner",
          ".write": "auth != null && auth.uid === $owner",
          "$hit": {
            ".write": "auth != null && !data.exists() && root.child('city/players/' + auth.uid).exists()",
            ".validate": "newData.hasChildren(['by', 'n', 'z', 'd', 'h', 't']) && newData.child('by').val() === auth.uid && newData.child('t').val() === now",
            "by": { ".validate": true },
            "n": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "z": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "d": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20000" },
            "h": { ".validate": "newData.isBoolean()" },
            "t": { ".validate": true },
            "$other": { ".validate": false }
          }
        }
      },
      "hits": {
        "$victim": {
          ".read": "auth != null && auth.uid === $victim",
          ".write": "auth != null && auth.uid === $victim",
          "$hit": {
            ".write": "auth != null && !data.exists() && root.child('city/players/' + auth.uid).exists()",
            ".validate": "newData.hasChildren(['by', 'n', 't', 'd', 'w']) && newData.child('by').val() === auth.uid && newData.child('t').val() === now",
            "by": { ".validate": true },
            "n": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "t": { ".validate": true },
            "d": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 400" },
            "w": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "$other": { ".validate": false }
          }
        }
      },
      "cars": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null && $id.length <= 40 && (!data.exists() || data.child('by').val() === '' || data.child('by').val() === auth.uid || data.child('t').val() < now - 600000)",
          ".validate": "newData.hasChildren(['ty', 'x', 'y', 'z', 'yaw', 'by', 't']) && (newData.child('by').val() === '' || newData.child('by').val() === auth.uid) && newData.child('t').val() === now",
          "ty": { ".validate": "newData.isString() && newData.val().matches(/^[a-z-]{2,20}$/)" },
          "x": { ".validate": "newData.isNumber()" },
          "y": { ".validate": "newData.isNumber()" },
          "z": { ".validate": "newData.isNumber()" },
          "yaw": { ".validate": "newData.isNumber()" },
          "by": { ".validate": "newData.isString()" },
          "t": { ".validate": true },
          "wr": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        }
      },
      "loot": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null && $id.length <= 40 && (!data.exists() || data.val() < now - 480000)",
          ".validate": "newData.val() === now"
        }
      },
      "builds": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null && $id.length <= 40 && ((!data.exists() && newData.child('by').val() === auth.uid) || !newData.exists())",
          ".validate": "newData.hasChildren(['ty', 'x', 'y', 'z', 'r', 'by', 't']) && newData.child('t').val() === now",
          "ty": { ".validate": "newData.isString() && newData.val().matches(/^(barricade|wall|spikes|mine|turret|beacon)$/)" },
          "cr": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "x": { ".validate": "newData.isNumber()" },
          "y": { ".validate": "newData.isNumber()" },
          "z": { ".validate": "newData.isNumber()" },
          "r": { ".validate": "newData.isNumber()" },
          "by": { ".validate": "newData.isString()" },
          "t": { ".validate": true },
          "$other": { ".validate": false }
        }
      },
      "world": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['ph', 'fuel', 'sig', 'evac', 'rnd'])",
        "ph": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3" },
        "fuel": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "sig": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "evac": { ".validate": "newData.isNumber() && newData.val() <= now + 600000" },
        "rnd": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "$other": { ".validate": false }
      },
      "drops": {
        ".read": "auth != null",
        "$slot": {
          ".write": "auth != null && (!data.exists() || data.child('t').val() < now - 3600000)",
          ".validate": "!newData.exists() || (newData.hasChildren(['by', 'n', 't']) && newData.child('by').val() === auth.uid && newData.child('t').val() === now)",
          "by": { ".validate": true },
          "n": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "t": { ".validate": true },
          "$other": { ".validate": false }
        }
      },
      "invites": {
        "$to": {
          ".read": "auth != null && auth.uid === $to",
          ".write": "auth != null && auth.uid === $to",
          "$from": {
            ".write": "auth != null && auth.uid === $from",
            ".validate": "!newData.exists() || (newData.hasChildren(['n', 'cr', 'cn', 't']) && newData.child('t').val() === now)",
            "n": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "cr": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "cn": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "t": { ".validate": true },
            "$other": { ".validate": false }
          }
        }
      },
      "stash": {
        "$cr": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('city/players/' + auth.uid + '/cr').val() === $cr || $cr === 'u:' + auth.uid)",
          "cash": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "v": { "$k": { ".validate": "newData.isNumber() && newData.val() >= 0" } },
          "b": { "$k": { ".validate": "newData.isNumber() && newData.val() >= 0" } },
          "$other": { ".validate": false }
        }
      },
      "feed": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.child('vu').val() === auth.uid) || (!newData.exists() && data.child('t').val() < now - 600000))",
          ".validate": "newData.hasChildren(['k', 'v', 'w', 'by', 'vu', 't']) && newData.child('t').val() === now",
          "k": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "v": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "w": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "by": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "vu": { ".validate": true },
          "t": { ".validate": true },
          "$other": { ".validate": false }
        }
      }
    },
    "draw": {
      "rooms": {
        "$code": {
          ".read": "auth != null && $code.matches(/^[A-Z]{4}$/)",
          "meta": {
            ".write": "auth != null && $code.matches(/^[A-Z]{4}$/) && newData.exists() && (!data.exists() || root.child('draw/rooms/' + $code + '/players/' + auth.uid).exists())",
            ".validate": "newData.hasChildren(['st', 'g', 'n', 'rd', 'rds', 'ts', 't'])",
            "st": {
              ".validate": "newData.isString() && newData.val().matches(/^(lobby|choose|draw|reveal|over)$/)"
            },
            "g": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "n": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "rd": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
            },
            "rds": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 240"
            },
            "ord": {
              ".validate": "newData.isString() && newData.val().length <= 400"
            },
            "i": {
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 20"
            },
            "dr": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "dl": {
              ".validate": "newData.isNumber()"
            },
            "cw": {
              ".validate": "newData.isString() && newData.val().length <= 1500"
            },
            "co": {
              ".validate": "newData.isBoolean()"
            },
            "c": {
              ".validate": "newData.isNumber()"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$other": {
              ".validate": false
            }
          },
          "players": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('draw/rooms/' + $code + '/meta').exists()",
              ".validate": "newData.hasChildren(['n', 'c', 'j'])",
              "n": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
              },
              "c": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15"
              },
              "j": {
                ".validate": "newData.isNumber() && newData.val() <= now"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "turns": {
            "$n": {
              ".write": "auth != null && root.child('draw/rooms/' + $code + '/players/' + auth.uid).exists() && !newData.exists()",
              "d": {
                ".write": "auth != null && root.child('draw/rooms/' + $code + '/players/' + auth.uid).exists()",
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "h": {
                ".write": "auth != null && root.child('draw/rooms/' + $code + '/players/' + auth.uid).exists()",
                ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
              },
              "s": {
                ".write": "auth != null && root.child('draw/rooms/' + $code + '/players/' + auth.uid).exists()",
                ".validate": "newData.isString() && newData.val().length <= 24"
              },
              "l": {
                ".write": "auth != null && root.child('draw/rooms/' + $code + '/players/' + auth.uid).exists()",
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "st": {
                ".write": "auth != null && root.child('draw/rooms/' + $code + '/players/' + auth.uid).exists()",
                ".validate": "newData.isNumber()"
              },
              "du": {
                ".write": "auth != null && root.child('draw/rooms/' + $code + '/players/' + auth.uid).exists()",
                ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 240"
              },
              "e": {
                ".write": "auth != null && root.child('draw/rooms/' + $code + '/players/' + auth.uid).exists()",
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8"
              },
              "g": {
                ".write": "auth != null && root.child('draw/rooms/' + $code + '/players/' + auth.uid).exists()",
                ".validate": "newData.isNumber()"
              },
              "hi": {
                ".write": "auth != null && root.child('draw/rooms/' + $code + '/players/' + auth.uid).exists()",
                ".validate": "newData.isString() && newData.val().length <= 60"
              },
              "w": {
                ".write": "auth != null && root.child('draw/rooms/' + $code + '/players/' + auth.uid).exists()",
                ".validate": "newData.isString() && newData.val().length <= 24"
              },
              "correct": {
                "$uid": {
                  ".write": "auth != null && auth.uid === $uid && root.child('draw/rooms/' + $code + '/players/' + auth.uid).exists() && (!data.exists() || !newData.exists())",
                  ".validate": "newData.isNumber() && newData.val() === now"
                }
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "ink": {
            "$n": {
              ".write": "auth != null && root.child('draw/rooms/' + $code + '/players/' + auth.uid).exists() && !newData.exists()",
              "$id": {
                ".write": "auth != null && root.child('draw/rooms/' + $code + '/players/' + auth.uid).exists() && (!newData.exists() || (!data.exists() && root.child('draw/rooms/' + $code + '/turns/' + $n + '/d').val() === auth.uid))",
                ".validate": "newData.hasChildren(['k'])",
                "k": {
                  ".validate": "newData.isString() && newData.val().matches(/^[lfux]$/)"
                },
                "p": {
                  ".validate": "newData.isString() && newData.val().length <= 4000"
                },
                "c": {
                  ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-f]{6}$/)"
                },
                "w": {
                  ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 80"
                },
                "gp": {
                  ".validate": "newData.isString() && newData.val().length <= 16"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          },
          "chat": {
            ".write": "auth != null && root.child('draw/rooms/' + $code + '/players/' + auth.uid).exists() && !newData.exists()",
            "$id": {
              ".write": "auth != null && root.child('draw/rooms/' + $code + '/players/' + auth.uid).exists() && (!data.exists() || !newData.exists())",
              ".validate": "newData.hasChildren(['u', 'n', 'm', 'k', 't']) && newData.child('u').val() === auth.uid",
              "u": {
                ".validate": true
              },
              "n": {
                ".validate": "newData.isString() && newData.val().length <= 16"
              },
              "m": {
                ".validate": "newData.isString() && newData.val().length <= 100"
              },
              "k": {
                ".validate": "newData.isString() && newData.val().matches(/^[mo]$/)"
              },
              "q": {
                ".validate": "newData.isNumber()"
              },
              "gd": {
                ".validate": "newData.isBoolean()"
              },
              "t": {
                ".validate": "newData.isNumber() && newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
